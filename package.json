{
  "name": "agent-ui-components",
  "version": "0.1.5",
  "description": "Production-grade React components for AI agent interfaces — chat, streaming, tool calls, thought traces, and status indicators.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "require": "./dist/*/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release": "pnpm build && changeset publish"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "shadcn",
    "ai",
    "agent",
    "chat",
    "ui-components",
    "streaming",
    "tool-calls"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/finnvosi/agent-ui-kit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": {
    "name": "finnevernight",
    "url": "https://github.com/finnvosi"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
